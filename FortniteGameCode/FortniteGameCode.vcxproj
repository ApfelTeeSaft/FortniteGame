<?xml version="1.0" encoding="utf-8"?>
<!--
  Stage 1 exact-match build of recovered Fortnite 2.5 client code.

  Toolset evidence (analysis/build-fingerprint.json): the reference Rich header
  records Utc1900 C/C++ build 24215 and Linker 14.00.24215, i.e. MSVC 19.00.24215.1
  (VS2015 Update 3). VS2019 drives the build through platform toolset v140, which
  invokes that exact compiler.

  Compiler switches mirror UE4.20 UnrealBuildTool VCToolChain.cs for a Win64
  Shipping, optimized, non-LTCG, no-exceptions, no-RTTI module (see docs/BUILDING.md).
  The output is a static library of COFF objects that tools/matching/compare.py
  compares with the reference image; it is not linked into an executable yet.
-->
<Project DefaultTargets="Build" ToolsVersion="16.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="ClientShipping|x64">
      <Configuration>ClientShipping</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>16.0</VCProjectVersion>
    <ProjectGuid>{5B0C2C8E-2F3A-4D55-9A4E-25A0F0C0D125}</ProjectGuid>
    <RootNamespace>FortniteGameCode</RootNamespace>
    <WindowsTargetPlatformVersion>10.0.10586.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='ClientShipping|x64'" Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <PlatformToolset>v140</PlatformToolset>
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>false</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='ClientShipping|x64'">
    <OutDir>$(MSBuildProjectDirectory)\Build\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildProjectDirectory)\Build\$(Configuration)\obj\</IntDir>
    <TargetName>FortniteGameCode</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='ClientShipping|x64'">
    <ClCompile>
      <PreprocessorDefinitions>UE_BUILD_SHIPPING=1;UE_BUILD_DEVELOPMENT=0;UE_BUILD_DEBUG=0;UE_BUILD_TEST=0;UE_GAME=1;UE_SERVER=0;WITH_EDITOR=0;WITH_EDITORONLY_DATA=0;WITH_SERVER_CODE=1;PLATFORM_WINDOWS=1;WIN32=1;_WIN32_WINNT=0x0601;WINVER=0x0601;_HAS_EXCEPTIONS=0;_CRT_STDIO_LEGACY_WIDE_SPECIFIERS=1;_SILENCE_STDEXT_HASH_DEPRECATION_WARNINGS=1;FNGC_MATCHING_HARNESS=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- Mirrors D3D11RHI.Build.cs PrivateIncludePaths ("Runtime/Windows/D3D11RHI/Private"). -->
      <AdditionalIncludeDirectories>$(MSBuildProjectDirectory)\Shims;$(MSBuildProjectDirectory)\Source\Runtime\Core\Public;$(MSBuildProjectDirectory)\Source\Runtime\Windows\D3D11RHI\Private;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <Optimization>Full</Optimization>
      <FavorSizeOrSpeed>Speed</FavorSizeOrSpeed>
      <InlineFunctionExpansion>AnySuitable</InlineFunctionExpansion>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <FloatingPointModel>Fast</FloatingPointModel>
      <StructMemberAlignment>8Bytes</StructMemberAlignment>
      <ExceptionHandling>false</ExceptionHandling>
      <BufferSecurityCheck>true</BufferSecurityCheck>
      <RuntimeTypeInfo>false</RuntimeTypeInfo>
      <DebugInformationFormat>OldStyle</DebugInformationFormat>
      <CompileAs>CompileAsCpp</CompileAs>
      <WarningLevel>Level4</WarningLevel>
      <DisableSpecificWarnings>4819;4456;4458;4459;4463;4838;%(DisableSpecificWarnings)</DisableSpecificWarnings>
      <SDLCheck>false</SDLCheck>
      <ConformanceMode>false</ConformanceMode>
      <MinimalRebuild>false</MinimalRebuild>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <ObjectFileName>$(IntDir)%(RelativeDir)</ObjectFileName>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalOptions>/Zc:inline /Zm850 /bigobj /Zo /source-charset:utf-8 /execution-charset:utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Lib>
      <TargetMachine>MachineX64</TargetMachine>
      <!-- LNK4221: a generated .static unit may define only file-static symbols (StaticEnum, registration
           objects). This library exists for object-level matching and is never linked, so that is expected. -->
      <AdditionalOptions>/ignore:4221 %(AdditionalOptions)</AdditionalOptions>
    </Lib>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClInclude Include="Shims\FortniteGameCode\EngineDecls.h" />
    <ClInclude Include="Shims\FortniteGameCode\RecoveryHarness.h" />
    <ClInclude Include="Shims\FortniteGameCode\UE4CodeGenRecovered.h" />
    <ClInclude Include="Shims\FortniteGameCode\UObjectRegistrationRecovered.h" />
    <ClInclude Include="Source\Runtime\Core\Public\Misc\RecoveredCString.h" />
    <ClInclude Include="Source\Runtime\Windows\D3D11RHI\Private\D3D11RHIRecoveredPrivate.h" />
    <!-- Unity members: compiled only through Module.D3D11RHI.cpp. -->
    <None Include="Source\Runtime\Windows\D3D11RHI\Private\D3D11Device.cpp" />
    <None Include="Source\Runtime\Windows\D3D11RHI\Private\Windows\WindowsD3D11Device.cpp" />
  </ItemGroup>
  <ItemGroup>
