    <ClCompile Include="Source\Runtime\Core\Private\Misc\Parse.cpp" />
    <ClCompile Include="Source\Runtime\Windows\D3D11RHI\Module.D3D11RHI.cpp" />
    <ClCompile Include="Source\Runtime\D3D12RHI\Private\Windows\WindowsD3D12Device.cpp" />
    <!-- Generated by tools/codegen/uht_creators.py: one UHT-shaped translation unit per class. -->
    <ClCompile Include="Source\Generated\UHT\*.gen.cpp" />
    <!-- Generated by tools/codegen/uht_structs.py: one translation unit per USTRUCT. -->
    <ClCompile Include="Source\Generated\UHT\Structs\**\*.gen.cpp" />
    <!-- Generated by tools/codegen/uht_enums.py: two translation units per run of consecutive UENUMs. -->
    <ClCompile Include="Source\Generated\UHT\Enums\**\*.gen.cpp" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
