    <ClInclude Include="Shims\FortniteGameCode\EngineStructsRecovered.h" />
    <ClInclude Include="Source\Generated\UHT\Classes.gen.h" />
    <ClInclude Include="Source\Runtime\Core\Public\Misc\RecoveredCString.h" />
    <ClInclude Include="Source\Runtime\Windows\D3D11RHI\Private\D3D11RHIRecoveredPrivate.h" />
    <!-- Unity members: compiled only through Module.D3D11RHI.cpp. -->
    <None Include="Source\Runtime\Windows\D3D11RHI\Private\D3D11Device.cpp" />
    <None Include="Source\Runtime\Windows\D3D11RHI\Private\Windows\WindowsD3D11Device.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="Source\Runtime\Core\Private\GenericPlatform\GenericPlatformMath.cpp" />
    <ClCompile Include="Source\Runtime\Core\Private\GenericPlatform\GenericPlatformMisc.cpp" />
    <ClCompile Include="Source\Runtime\Core\Private\Math\UnrealMath.cpp" />
    <ClCompile Include="Source\Runtime\Core\Private\Math\Color.cpp" />
    <ClCompile Include="Source\Runtime\Core\Private\Misc\DateTime.cpp" />
    <ClCompile Include="Source\Runtime\Core\Private\Misc\Timespan.cpp" />
    <ClCompile Include="Source\Runtime\Core\Private\Windows\WindowsPlatformTime.cpp" />
    <ClCompile Include="Source\Runtime\Core\Private\GenericPlatform\GenericPlatformProcess.cpp" />
    <ClCompile Include="Source\Runtime\Core\Private\Stats\Stats2.cpp" />
    <ClCompile Include="Source\Runtime\Core\Private\Misc\CommandLine.cpp" />
    <ClCompile Include="Source\Runtime\Core\Private\Misc\Parse.cpp" />
    <ClCompile Include="Source\Runtime\Windows\D3D11RHI\Module.D3D11RHI.cpp" />
    <ClCompile Include="Source\Runtime\D3D12RHI\Private\Windows\WindowsD3D12Device.cpp" />
    <ClCompile Include="Source\Runtime\D3D12RHI\Private\Unattributed\D3D12RHIPrivateUser_0162C1D0.cpp" />
    <ClCompile Include="Source\Runtime\Engine\Private\GameplayStatics.cpp" />
    <ClCompile Include="Source\Runtime\Engine\Private\KismetMathLibrary.cpp" />
    <ClCompile Include="Source\Runtime\Portal\LauncherCheck\Private\LauncherCheckModule.cpp" />
    <ClCompile Include="Source\FortniteGame\Private\Unattributed\CommandLineChecks.cpp" />
    <!-- Generated UHT code: per-item fragments (tools/codegen/uht_*.py) are compiled only through the
         unity units tools/codegen/unity.py assembles in the references recovered source order. -->
    <ClCompile Include="Source\Generated\UHT\Unity\*.gen.cpp" />
    <!-- Native accessors (tools/codegen/uht_accessors.py): one unit per package, apart from the
         exec thunks that call them, as the reference's class .cpp files are. -->
    <ClCompile Include="Source\Generated\Natives\*.natives.cpp" />
    <!-- GameplayAbilities attribute getters (tools/codegen/attribute_getters.py): one unit per class. -->
    <ClCompile Include="Source\Generated\AttributeGetters\*.gen.cpp" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
